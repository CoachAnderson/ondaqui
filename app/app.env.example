# Copie para app.env e ajuste.
# Endereço da API. No celular com Expo Go, use o IP do computador na rede Wi-Fi
# (no Windows: comando ipconfig, campo "Endereço IPv4"). Ex.: http://192.168.0.10:3333
EXPO_PUBLIC_API_URL=http://192.168.0.10:3333
# Cidade fixa do app (endereço do licenciado). Deixe vazio para o usuário escolher.
EXPO_PUBLIC_TENANT=bauru
# Nome na loja
EXPO_PUBLIC_BRAND=OnDaqui Bauru
# Endereço do painel, usado no link "acompanhe a corrida"
EXPO_PUBLIC_SHARE_URL=http://192.168.0.10:5173
# Id do projeto no EAS (necessário para notificações push). Crie com: npx eas-cli@latest init
EAS_PROJECT_ID=
